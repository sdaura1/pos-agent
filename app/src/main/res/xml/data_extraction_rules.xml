<?xml version="1.0" encoding="utf-8"?><!--
   Session tokens are encrypted and must not be backed up or transferred.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
